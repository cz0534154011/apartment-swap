# הגדרות להרצת הבדיקות האוטומטיות (npm test).
# העתיקו לקובץ בשם .env.test
# חשוב: מסד נפרד לבדיקות! הבדיקות מוחקות את כל הנתונים בו.
# כאמצעי זהירות, שם המסד חייב לכלול את המילה test.

NODE_ENV=test
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/swap_test?schema=public"
JWT_SECRET="test-secret-test-secret-test-secret-123"
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173
ADMIN_CONTACT_EMAIL=admin@example.com
