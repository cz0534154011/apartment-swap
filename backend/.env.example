# העתיקו את הקובץ הזה לקובץ בשם .env ומלאו ערכים אמיתיים.
# לעולם אל תעלו את קובץ .env ל-GitHub.

# development / production
NODE_ENV=development
PORT=3000

# כתובת החיבור למסד PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/swap_dev?schema=public"

# סוד לחתימת ה-Token. לפחות 32 תווים אקראיים. לכל סביבה סוד אחר.
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN=24h

# כתובות האתר (React) שמותר להן לפנות לשרת, מופרדות בפסיק
CORS_ORIGIN=http://localhost:5173

# המייל של מנהל האתר, מוצג למשתמשים לפניות ותלונות
ADMIN_CONTACT_EMAIL=admin@example.com

# --- נתוני הדגמה (Seed) ---
# בפיתוח: אם לא מגדירים, נוצרים admin@example.com / Admin1234 ומשתמשי דוגמה עם Demo1234
# בענן (production): מנהל נוצר רק אם מגדירים את שני הערכים האלה
ADMIN_EMAIL=
ADMIN_PASSWORD=
# בענן: משתמשי דוגמה רק אם SEED_DEMO_DATA=true וגם מגדירים סיסמה
SEED_DEMO_DATA=
DEMO_USER_PASSWORD=
